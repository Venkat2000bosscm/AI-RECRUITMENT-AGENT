# Optional: enables the main LLM (any OpenAI-compatible endpoint). Without it, offline templates are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Demo mode uses the X-User-Id selector. Disable only after configuring a real identity provider.
DEMO_MODE=true
AUTO_CREATE_SCHEMA=true

# Decision layer thresholds
STRONG_MATCH_THRESHOLD=0.75
PARTIAL_MATCH_THRESHOLD=0.5
MIN_CONFIDENCE=0.65
LOW_APPLICATION_THRESHOLD=5
SCORE_WEIGHT_REQUIRED_SKILLS=0.5
SCORE_WEIGHT_PREFERRED_SKILLS=0.15
SCORE_WEIGHT_EXPERIENCE=0.2
SCORE_WEIGHT_TEXT_RELEVANCE=0.15

# Required by Docker Compose; use a long, URL-safe secret outside local demos.
POSTGRES_USER=recruit
POSTGRES_PASSWORD=replace-with-random-url-safe-secret
POSTGRES_DB=recruit

# Seed demo users, interviewers, jobs and sample resumes on first start
SEED_DEMO_DATA=true

# Optional SMTP delivery (otherwise emails go to the in-app outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=recruiting@example.com
